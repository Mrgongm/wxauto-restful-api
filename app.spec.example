# -*- mode: python ; coding: utf-8 -*-
import os
from pathlib import Path
from PyInstaller.utils.hooks import collect_submodules


# ================================ 自行修改此处内容 ================================

py = 'run.py'              # 程序入口文件
app_name = 'jiawa-wx-api'    # exe 程序名

# ================================= 以下请勿修改 ===================================

ROOT = os.path.abspath('.')


def collect_wxautox4_files():
    """完整收集 wxautox4 所有需要的文件（DLL、模型、配置等）"""
    try:
        import wxautox4
        base_path = Path(wxautox4.__file__).parent
    except ImportError:
        print("未找到 wxautox4 库，请先 pip install wxautox4")
        return []

    files = []

    patterns = {
        'binaries': ['*.dll', '*.pyd', '*.exe'],
        'datas': ['*.xnet', '*.nas', '*.txt', 'RecDict']
    }

    for file_type, exts in patterns.items():
        for pattern in exts:
            if pattern == 'RecDict':
                recdict = base_path / 'ocr' / 'Model' / 'RecDict'
                if recdict.exists():
                    files.append((str(recdict), 'wxautox4/ocr/Model'))
            else:
                for file in base_path.rglob(pattern):
                    if file.is_file():
                        rel_path = file.relative_to(base_path).parent
                        target_dir = str(Path('wxautox4') / rel_path)
                        files.append((str(file), target_dir))

    return files


def collect_sounddevice_files():
    """收集 sounddevice 的 PortAudio DLL"""
    try:
        import _sounddevice_data
        base_path = Path(_sounddevice_data.__file__).parent / 'portaudio-binaries'
    except ImportError:
        return []

    files = []
    for dll in base_path.glob('*.dll'):
        files.append((str(dll), '_sounddevice_data/portaudio-binaries'))
    return files


def collect_pywin32_files():
    """收集 pywin32 的全部 DLL/PYD 文件（win32ui 等模块依赖）"""
    files = []
    try:
        import win32api
        site_pkg = Path(win32api.__file__).parent.parent

        # 1. pywin32_system32 DLLs（pythoncom, pywintypes）→ 放到根目录
        sys32 = site_pkg / 'pywin32_system32'
        if sys32.exists():
            for dll in sys32.glob('*.dll'):
                files.append((str(dll), '.'))

        # 2. win32/*.pyd 扩展模块 → 放到根目录
        win32_dir = site_pkg / 'win32'
        for pyd in win32_dir.glob('*.pyd'):
            files.append((str(pyd), '.'))

        # 3. pythonwin/win32ui.pyd 等 → 放到根目录
        pythonwin_dir = site_pkg / 'pythonwin'
        for pyd in pythonwin_dir.glob('*.pyd'):
            files.append((str(pyd), '.'))
        for dll in pythonwin_dir.glob('*.dll'):
            files.append((str(dll), '.'))

        # 4. MFC 运行时 DLL（win32ui.pyd 的关键依赖）
        # 新电脑上没有 mfc140u.dll，必须打包进去
        mfc_names = ['mfc140u.dll', 'mfc140.dll', 'mfcm140u.dll', 'mfcm140.dll']
        system32 = Path(os.environ['SystemRoot']) / 'System32'
        for name in mfc_names:
            mfc_path = system32 / name
            if mfc_path.exists():
                files.append((str(mfc_path), '.'))

    except ImportError:
        print("未找到 pywin32，请先 pip install pywin32")
    return files


wxautox4_files = collect_wxautox4_files()
sounddevice_files = collect_sounddevice_files()
pywin32_files = collect_pywin32_files()

a = Analysis(
